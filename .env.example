# Copy this file to .env and fill in the values. Never commit .env.

# --- Django ---
# Generate with: backend/.venv/bin/python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL 16) ---
# DB_ENGINE=postgresql for the real system; sqlite is a no-server fallback.
DB_ENGINE=postgresql
DB_NAME=repossessed_devices
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Browser access ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_AGE=28800

# --- Application ---
DEFAULT_CURRENCY=RWF
MFA_ISSUER_NAME=Yellow Device Lifecycle
MAX_UPLOAD_SIZE_MB=5
