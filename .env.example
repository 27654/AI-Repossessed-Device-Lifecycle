# Copy this file to .env and fill in the values. Never commit .env.

# --- Django ---
# Generate with: backend/.venv/bin/python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL 16, the only supported database) ---
DB_NAME=repossessed_devices
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Browser access ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Maximum session length and idle timeout, in seconds.
SESSION_COOKIE_AGE=28800
SESSION_IDLE_TIMEOUT=1800

# --- Login security ---
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15

# --- Application ---
DEFAULT_CURRENCY=RWF
MFA_ISSUER_NAME=Yellow Device Lifecycle
# Fernet key that encrypts TOTP secrets at rest. Leave empty to derive one from DJANGO_SECRET_KEY.
# Generate with: backend/.venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
MAX_UPLOAD_SIZE_MB=5
